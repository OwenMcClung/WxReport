{
  "name": "quickreport",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "tunnel": "cloudflared tunnel --url https://localhost:5174 --no-tls-verify",
    "build:client": "npm run build --prefix client",
    "build": "npm install --prefix client && npm run build --prefix client && npm install --prefix server --omit=dev",
    "start": "node server/index.js",
    "package:win": "npm run package:win --prefix server",
    "package:mac": "npm run package:mac --prefix server",
    "package:all": "npm run package:all --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}